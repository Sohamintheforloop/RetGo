# Copy to .env.local (git-ignored). All values are public: they are compiled into the app.
VITE_WORKER_URL=http://localhost:8787
# Leave empty: in development the patcher is found on port 8000, and the packaged app uses its own address.
VITE_PATCHER_URL=
# Printed by: python tools/maintainer.py keygen   (leave empty to switch private requests off)
VITE_MAINTAINER_PUBKEY=
